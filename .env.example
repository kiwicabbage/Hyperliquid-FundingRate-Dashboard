# Used by the Python collectors
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-with-your-influxdb-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=funding

# Used only when InfluxDB is initialized by Docker Compose
